{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "openapi:types": "openapi-typescript http://localhost:8000/openapi.json -o src/types/api.types.ts",
    "openapi:zod": "openapi-zod-client --url http://localhost:8000/openapi.json --output src/types/api.zod.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@mantine/core": "^8.2.1",
    "@mantine/hooks": "^8.2.1",
    "@mantine/notifications": "^8.2.1",
    "@tabler/icons-react": "^3.34.0",
    "@tanstack/react-query": "^5.83.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.10.0",
    "mantine-datatable": "^8.1.3",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^3.1.0",
    "tailwindcss": "^3.4.17",
    "zod": "^3.23.8",
    "zustand": "^5.0.6",
    "@tanstack/react-virtual": "^3.10.9"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.83.0",
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^24.0.0",
    "openapi-typescript": "^7.4.2",
    "openapi-zod-client": "^1.18.3",
    "prettier": "^3.1.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.3",
    "vitest": "^3.2.4",
    "vitest-axe": "0.1.0"
  }
}
